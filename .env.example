# YouTube Data API (ใช้กับ npm run upload-api)
# ไม่ต้องใช้ไฟล์นี้แล้ว — ใช้ client_secret.json แทน

# ถ้าจะใช้ Playwright (npm run upload):
# YT_EMAIL=your-google-email@gmail.com

# Facebook Graph API (ใช้กับ npm run upload-fb-api)
# 1. สร้าง Facebook App -> https://developers.facebook.com
# 2. ไปที่ Graph API Explorer -> เลือก App -> ขอ permission pages_manage_posts
# 3. กด Get Token -> เลือก Page -> คัดลอก Page ID และ Access Token
# FACEBOOK_PAGE_ID=your-page-id
# FACEBOOK_ACCESS_TOKEN=your-page-access-token
